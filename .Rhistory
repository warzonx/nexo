library(ggplot2)
# Coordonnées des variables
variables <- data.frame(
Variable = c("SURF", "FREQ", "RECET", "JOUR"),
F1 = c(0.954, -0.602, 0.962, 0.603),
F2 = c(-0.151, 0.731, 0.147, 0.734)
)
# Construction du cercle unité
theta <- seq(0, 2*pi, length.out = 300)
cercle <- data.frame(
x = cos(theta),
y = sin(theta)
)
# Cercle des corrélations
ggplot() +
geom_path(
data = cercle,
aes(x = x, y = y),
color = "grey40"
) +
geom_segment(
data = variables,
aes(x = 0, y = 0, xend = F1, yend = F2),
arrow = arrow(length = unit(0.2, "cm")),
color = "red",
linewidth = 0.8
) +
geom_text(
data = variables,
aes(x = F1, y = F2, label = Variable),
color = "blue",
nudge_y = 0.06
) +
geom_hline(yintercept = 0, color = "grey60") +
geom_vline(xintercept = 0, color = "grey60") +
coord_fixed(
xlim = c(-1.1, 1.1),
ylim = c(-1.1, 1.1)
) +
labs(
title = "Cercle des corrélations",
x = "F1 (64,02 %)",
y = "F2 (27,96 %)"
) +
theme_minimal()
